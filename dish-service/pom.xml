<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.apesource</groupId>
        <artifactId>project0914</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dish-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>dish-service</name>
    <description>菜品服务：食材组合召回（Elasticsearch）+ 菜品详情</description>

    <properties>
        <java.version>17</java.version>

        <!--
            Spring AI 版本 —— 这里是【兼容性实验】，不是最终方案。

            背景：Spring AI 官方要求 Spring Boot 3.4.x / 3.5.x，
                  而本项目是 3.2.4，属于【非官方支持组合】。
            选 1.0.0-M6 的理由：它正是 springAi2026 项目在用的版本，
                  用它来验证「熟悉的版本能不能直接搬到本项目」，结论最有参考价值。

            实测结论见项目根目录 es/dish-search.md 的「Spring AI 兼容性实测」一节。
        -->
        <spring-ai.version>1.0.0-M6</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                Spring AI BOM：统一管理所有 spring-ai-* 模块的版本，
                下面的依赖就不用各自写 version（与 Boot 父 pom 管版本同理）。
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web：提供 REST 接口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：@NotBlank / @NotEmpty / @Size 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            ★ 这里【故意不引】 spring-boot-starter-data-elasticsearch。

            原因：Boot 3.2.4 能用的 Spring Data ES 5.2.x，官方兼容目标是 ES 8.11.1。
            服务端起初是原生解压版 7.16.2（明确不在兼容范围内），现在换成了
            Docker 容器里的 elasticsearch:8.16.0 —— 更接近了，但仍不是官方钉死的
            那个版本，没必要为此把数据访问层整个交给它。

            改用自写的轻量客户端：用 Spring 6.1 自带的 RestClient 直接发 JSON DSL。
            好处是【零版本耦合】—— 这次从 7.16.2 升到 8.16.0，业务代码一行未改，
            已经验证过这个决定是划算的。

            索引 mapping 与查询 DSL 见项目根目录 es/dish-search.md。
        -->

        <!-- MyBatis-Plus：菜品 / 食材 / 评分 / 收藏等主数据落库用 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- 公共模块：Result 统一返回体、BusinessException 等 -->
        <dependency>
            <groupId>com.apesource</groupId>
            <artifactId>common-service</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- Nacos 配置中心 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- Nacos 服务注册发现：让网关能按服务名找到本服务 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- 与 account-service 保持一致，兼容 bootstrap.yml 老方式的加载时机 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>

        <!--
            Spring AI 的 Ollama 接入 —— 用于「AI 生成菜谱」，走完全异步的独立线程池。

            注意 artifact 命名：1.0.0-M6 这代叫 spring-ai-ollama-spring-boot-starter；
            从 1.1.x 起改名为 spring-ai-starter-model-ollama（官方在 1.0 GA 后调整过命名）。
            以后升级要同步改这里的 artifactId，否则报「找不到依赖」。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-ollama-spring-boot-starter</artifactId>
        </dependency>

        <!-- Lombok：@Data / @RequiredArgsConstructor / @NoArgsConstructor 等 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                父 pom 是自建的（没继承 spring-boot-starter-parent），
                repackage 目标不会自动绑定，必须显式声明，否则打出来的 jar
                没有 Main-Class，运行报「jar中没有主清单属性」。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
