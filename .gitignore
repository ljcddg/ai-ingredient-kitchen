# ============================================================
# AI 灵感厨房 · 仓库级忽略规则
# ============================================================
# 各子模块（account-service / common-service / gateway / frontend-vue）
# 自带独立的 .gitignore，本文件只负责根目录与跨模块的通用规则。
# ============================================================

# ---------- 构建产物 ----------
target/
build/
out/
dist/
*.jar
*.war
# Maven Wrapper 自身必须入库，否则克隆下来无法构建
!.mvn/wrapper/maven-wrapper.jar

# ---------- 前端依赖与产物 ----------
node_modules/
.vite/
.npm/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 ----------
*.log
logs/
svc-logs/

# ---------- 本地运行配置与凭据（严禁入库） ----------
# 真实数据库密码、JWT secret、个人环境地址写在这里，不要提交
**/application-local.yml
**/application-local.yaml
**/application-local.properties
**/bootstrap-local.yml
.env
.env.local
*.pem
*.p12
*.key
*.jks
*.keystore

# ---------- 本地中间件数据目录 ----------
# 若在项目内解压 / 运行过这些组件，产生的数据不允许入库
elasticsearch-*/
kibana-*/
nacos-server-*/
redis-*/
apache-maven-*/
*.pid

# ---------- 本地调试产物（诊断截图、浏览器自动化 profile） ----------
# 说明：文档与 README 引用的示意图统一放 docs/images/，不受此规则影响
cdp-*-profile/
chrome-profile/
*-profile/
.cache/
*.png
*.jpg
*.jpeg
*.gif

# ---------- 本地工作目录（.workbuddy） ----------
# 浏览器自动化 CDP profile 会生成上百 MB 缓存，且是本机专属
.workbuddy/
.workbuddy*/

# ---------- 打包文件 ----------
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ---------- 识菜上传目录（运行期产物，禁入库） ----------
# 用户上传的菜品照片与裁剪小图（ai.vision.upload-dir=uploads/vision）。
# 图片后缀本就被上面的 *.jpg/*.png 规则忽略，这里显式列出目录，
# 连带忽略可能产生的非图片临时文件。
dish-service/uploads/

# ---------- 本地备份与临时产物 ----------
# 改版前的手动快照（如 backup/login-vue-2026-10-16/）与脚本输出目录
backup/
output/

# ---------- 其他 ----------
*.bak
*.orig
*.tmp
*.temp

# ---------- 本地调试产物（补充） ----------
# 运行时日志目录（内含 sql 备份等临时产物）
.logs/
# Python 缓存（verify-*.py 运行产生）
__pycache__/
*.pyc
# 本地验证脚本的中间产物
*-args.tmp
.sync-verify.json
